{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-dashboard-worker",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./public"
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 */3 * * *"
    ]
  }
}
